```toml
# Copy these into Streamlit Community Cloud: App -> Settings -> Secrets.
# For local testing you may save them as .streamlit/secrets.toml (this file is git-ignored).
# NEVER commit real secrets to GitHub.

# --- Owner details shown in notices, reports and legal pages -----------------
OWNER_NAME    = "Oyinkansola Osibodu"
CONTACT_EMAIL = "oyinkansolaosibodu@gmail.com"

# --- Admin panel ---------------------------------------------------------------
ADMIN_EMAILS     = "oyinkansolaosibodu@gmail.com"
ADMIN_PASSPHRASE = "CHANGE-ME-to-a-long-random-phrase"

# --- Database (REQUIRED for real users) ----------------------------------------
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Bank-transfer payments (no Paystack needed) -----------------------------------
BANK_DETAILS = """
**Account name:** YOUR FULL NAME

**Bank:** BANK NAME

**Account number:** 0000000000

**Currency:** NGN
"""

# --- Paystack online payments (OPTIONAL) ---------------------------------------
PAYSTACK_SECRET_KEY = "sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
APP_URL             = "https://YOUR-APP-NAME.streamlit.app"

# --- Pricing and limits --------------------------------------------------------
PRO_PRICE_NGN   = 5000
FREE_DAILY_RUNS = 5

# --- Report authenticity ------------------------------------------------------
REPORT_SIGNING_KEY = "CHANGE-ME-another-long-random-string"